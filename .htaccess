# GTUPEDIA — Hostinger / Apache
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Apex domain (change to www if you prefer www.gtupedia.com)
RewriteCond %{HTTP_HOST} ^www\.gtupedia\.com [NC]
RewriteRule ^ https://gtupedia.com%{REQUEST_URI} [L,R=301]

ErrorDocument 404 /404.html

# Serve index.html inside nested SEO folders (BE/DI/…/subject/index.html)
DirectoryIndex index.html index.php
Options -Indexes +FollowSymLinks

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Allow dashboard.gtupedia.com to read JSON API from browser
  <FilesMatch "\.(json)$">
    SetEnvIf Origin "^https://dashboard\.gtupedia\.com$" CORS=1
    Header set Access-Control-Allow-Origin "https://dashboard.gtupedia.com" env=CORS
    Header set Access-Control-Allow-Methods "GET, OPTIONS" env=CORS
    Header set Access-Control-Max-Age "86400" env=CORS
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType application/json "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  Header set Cache-Control "no-cache" "expr=%{REQUEST_URI} =~ m#/assets/app\.js# || %{REQUEST_URI} =~ m#/assets/site-base\.js# || %{REQUEST_URI} =~ m#\.html$#"
</IfModule>
