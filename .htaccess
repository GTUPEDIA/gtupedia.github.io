# GTUPEDIA — Hostinger / Apache
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Apex domain (change to www if you prefer www.gtupedia.com)
RewriteCond %{HTTP_HOST} ^www\.gtupedia\.com [NC]
RewriteRule ^ https://gtupedia.com%{REQUEST_URI} [L,R=301]

ErrorDocument 404 /404.html

# Serve index.html inside nested SEO folders (BE/DI/…/subject/index.html)
DirectoryIndex index.html index.php
Options -Indexes +FollowSymLinks

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType application/json "access plus 1 day"
</IfModule>
